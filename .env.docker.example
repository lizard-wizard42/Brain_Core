# Opcional: `docker compose up -d` funciona sem este arquivo. Se você o criar,
# esses valores são usados somente na primeira inicialização; depois, o volume
# privado persistente continua sendo a fonte de verdade.
POSTGRES_DB=brain_core
POSTGRES_USER=brain_core
POSTGRES_PASSWORD=
JWT_SECRET=

# Opcional para instalações automatizadas. Sem estas variáveis, o navegador
# mostra o assistente de primeiro acesso e cria o administrador uma única vez.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=
SEED_DEMO_DATA=false
PAGE_VERSION_RETENTION=100

# Para Tailscale Serve, defina o domínio HTTPS do seu dispositivo, por exemplo:
# CORS_ORIGIN=https://computer.example-tailnet.ts.net
# AUTH_COOKIE_SECURE=true
CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080
AUTH_COOKIE_SECURE=false
