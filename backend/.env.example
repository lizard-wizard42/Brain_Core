# Servidor
HOST=127.0.0.1
PORT=3001
NODE_ENV=production
CORS_ORIGIN=http://localhost:8001
# Vazio por padrão. Informe IPs/CIDRs apenas quando existir um proxy controlado.
TRUSTED_PROXIES=

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=brain_core
DB_USER=brain_core
DB_PASSWORD=troque-por-uma-senha-forte

# Opcional: cria somente o primeiro administrador em um banco vazio.
# Remova ou deixe vazias após o primeiro start; nunca use senha de exemplo.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=

# Opcional: preenche um banco vazio com três páginas fictícias locais.
SEED_DEMO_DATA=false
PAGE_VERSION_RETENTION=100

# Gere com: openssl rand -hex 32
# O valor abaixo e deliberadamente invalido para impedir uso acidental.
JWT_SECRET=change-me

# Dados locais
MD_SOURCE_PATH=../data/markdown
UPLOADS_DIR=../uploads
# Limite total da pasta de uploads (5 GiB por padrão).
UPLOADS_MAX_BYTES=5368709120

# Recurso privilegiado: desligado por padrao.
TERMINAL_ENABLED=false
TERMINAL_DEFAULT_DIR=/workspace
TERMINAL_ALLOWED_ROOTS=/workspace
TERMINAL_TMUX_SOCKET=/tmp/brain-core-tmux.sock

# Integracoes opcionais. Deixe vazias para manter a instalacao local.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
CELTWO_MEMORY_MODE=offline
CELTWO_MEMORY_URL=
CELTWO_MEMORY_TOKEN=
OPENAI_API_KEY=
