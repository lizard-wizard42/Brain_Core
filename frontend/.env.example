# Public base path. Use / for a normal local installation.
VITE_BASE=/

# Leave empty when the frontend and backend share the same origin.
VITE_API_BASE=

# Socket.IO path under the selected base path.
VITE_SOCKET_PATH=/socket.io

# Recurso privilegiado: mantenha desligado, exceto em uma instancia pessoal confiavel.
VITE_TERMINAL_ENABLED=false
